{
  "name": "creatoros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CreatorOS local-first publishing workspace",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --dir",
    "test:browser": "playwright test",
    "desktop:windows": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.creatoros.workspace",
    "productName": "CreatorOS",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
